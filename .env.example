# === Database ===
DATABASE_URL=postgresql+asyncpg://sandbelt:yourpassword@localhost:5432/sandbelt_db
DATABASE_URL_SYNC=postgresql://sandbelt:yourpassword@localhost:5432/sandbelt_db

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Google Earth Engine ===
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=secrets/gee-key.json

# === ERA5 CDS API ===
CDS_URL=https://cds.climate.copernicus.eu/api/v2
CDS_KEY=your-uid:your-api-key

# === LLM (RAG 问答, OpenAI-兼容接口) ===
# 默认指向中科院 uni-api (deepseek-v3.2); 换模型/服务商只改这三行
# 撰写时 uni-api 上以下模型可用：deepseek-v3.2 / deepseek-v4-flash /
# gpt-oss-120b / minimax-m27（探测时间 2026-05）。原 qwen3:235b 已下线。
LLM_BASE_URL=https://uni-api.cstcloud.cn/v1
LLM_API_KEY=your-uni-api-key
LLM_MODEL=deepseek-v3.2
LLM_MAX_TOKENS=2048

# === RAG pipeline ===
RAG_EMBEDDER=BAAI/bge-m3
RAG_RERANKER=BAAI/bge-reranker-v2-m3
RAG_TOP_K_RETRIEVE=20
RAG_TOP_K_RERANK=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
CHROMA_PERSIST_DIR=backend/rag/chroma_store
RAG_DOCS_DIR=backend/rag/docs

# === OpenAI (Embedding, 可选) ===
OPENAI_API_KEY=sk-xxxxx

# === App ===
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# === Observability (all optional) ===
# Sentry — leave empty to disable the SDK entirely (zero overhead).
# Set traces sample rate to e.g. 0.1 once you have a paid tier and care
# about performance spans (free tier eats them fast).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Global per-IP rate limit (slowapi) — set to empty to disable.
# Examples: "100/minute", "500/hour", "10/second"
API_RATE_LIMIT=100/minute

# Per-route limits on expensive endpoints. Stricter than the global
# because /chat costs LLM tokens (real money) and /scenario runs CPU-
# heavy simulation. Empty value falls back to API_RATE_LIMIT.
CHAT_RATE_LIMIT=20/minute
SCENARIO_RATE_LIMIT=30/minute

# Pre-warm the Prophet NDVI forecast cache at backend startup so the first
# dashboard visit doesn't pay cold-fit cost (~5-10s/region). Fire-and-
# forget background task — never blocks uvicorn boot. Default off because
# tests + dev boots prefer fast startup; flip to "true" on production.
# Alternative: run `python -m scripts.warm_forecast_cache` from cron.
CACHE_WARM_ON_BOOT=false

# Prometheus: GET /metrics is always exposed when the dep is installed;
# point your scraper at backend:8000/metrics.
#
# An optional Prometheus + Grafana stack ships under compose profile `obs`:
#   docker compose --profile obs up -d
# then open Grafana at http://localhost:${GRAFANA_PORT:-3001} (admin/admin)
# and the "SandbeltOS API" dashboard auto-loads via provisioning.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# === Docker Compose (部署用, 本地开发可忽略) ===
# Postgres 初始化；首次 up -d 时生效, 改密码请同步改 DATABASE_URL
POSTGRES_DB=sandbelt_db
POSTGRES_USER=sandbelt
POSTGRES_PASSWORD=change-me-to-a-strong-password

# pgBouncer (optional, profile=scale). To enable:
#   docker compose --profile scale up -d
# then point DATABASE_URL at pgbouncer:6432:
#   DATABASE_URL=postgresql+asyncpg://sandbelt:<pw>@pgbouncer:6432/sandbelt_db
# Note: prepared-statement caches must be off in transaction pool mode
# (SQLAlchemy + asyncpg do this via prepared_statement_cache_size=0).
# 宿主机端口映射 (需要改端口时用)
BACKEND_PORT=8000
FRONTEND_PORT=3000
# 前端打包时注入的后端地址；生产改成 http://<服务器公网IP>:8000 或 https://api.yourdomain.com
# 注意: Next.js 的 NEXT_PUBLIC_* 变量在 build 时 inline, 改完必须重新 build
NEXT_PUBLIC_API_URL=http://localhost:8000

# 设为 true 才会在 NDVI 预测 / 情景模拟卡角显示「演示数据」角标。
# 默认空 = 不显示(GEE / ERA5 / SMAP 真实数据已接入)。
# 仅在做合成数据演示或情景模型未校准的回归场景时打开。
NEXT_PUBLIC_DEMO_MODE=
